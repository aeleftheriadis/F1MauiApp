<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> so an inherited machine or user-level feed cannot supply a package this
         repository did not choose. Adding a feed is a reviewable change, not an accident. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
